# GoviMart Mobile API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to source control.

# ---------------------------------------------------------------------------
# JWT CONFIGURATION
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# DATABASE NAMES (do not change unless your schema changes)
# ---------------------------------------------------------------------------
DB_NAME_PC=plant_care
DB_NAME_CO=collection_officer
DB_NAME_MP=market_place
DB_NAME_AD=agro_world_admin

# ---------------------------------------------------------------------------
# DATABASE CONNECTION (MySQL)
# ---------------------------------------------------------------------------
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_PORT=3306

# ---------------------------------------------------------------------------
# CLOUDFLARE R2 STORAGE
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_BUCKET_NAME=polygon
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# ---------------------------------------------------------------------------
# SMS GATEWAY (Shoutout)
# https://getshoutout.com
# ---------------------------------------------------------------------------
SHOUTOUT_API_KEY=

# ---------------------------------------------------------------------------
# EMAIL SMTP (defaults to Gmail SMTP if not set)
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# PAYMENT GATEWAY CONFIGURATION (Strategy Pattern)
# ---------------------------------------------------------------------------
# Options: payments_lk | payhere
ACTIVE_PAYMENT_GATEWAY=payments_lk

# Payments.lk (Payable) Configuration
PAYMENTS_LK_API_URL=https://api.payments.lk/v1
PAYMENTS_LK_SECRET_KEY=sk_test_your_sandbox_secret_key
PAYMENTS_LK_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
APP_DEEP_LINK_SCHEME=polygon

# PayHere Configuration (Fallback / Alternative)
PAYHERE_MERCHANT_ID=1237830
PAYHERE_MERCHANT_SECRET=Mjk4NjMyODI2MjMyMDU0MDMyMzgyNDY5Nzc0OTkwNDEzNzQwNTcxMg==
PAYHERE_SANDBOX=true
PAYHERE_DOMAIN=https://dev.govimart.com

# ---------------------------------------------------------------------------
# OPTIONAL / DEFAULTS
# ---------------------------------------------------------------------------
# CLIENT_ORIGIN=http://localhost:8081
# PORT=3000
# NODE_ENV=development
# SALT_ROUNDS=10

